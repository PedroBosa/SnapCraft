# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Windows command and script files
*.bat eol=crlf
*.cmd eol=crlf
*.ps1 eol=crlf

# Binary image formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# Vector graphics
*.svg text eol=lf
