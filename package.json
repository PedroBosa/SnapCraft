{
  "name": "snapcraft",
  "version": "0.1.0",
  "description": "Estúdio de alta densidade para apresentação de código e captura de telas com modelo de iluminação em camadas e rasterização no navegador.",
  "author": {
    "name": "Pedro Bosa",
    "url": "https://github.com/PedroBosa"
  },
  "license": "MIT",
  "homepage": "https://pedrobosa.github.io/SnapCraft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroBosa/SnapCraft.git"
  },
  "bugs": {
    "url": "https://github.com/PedroBosa/SnapCraft/issues"
  },
  "keywords": [
    "code-presentation",
    "screenshot-studio",
    "syntax-highlighting",
    "developer-tools",
    "ambient-occlusion",
